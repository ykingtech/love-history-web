# Public browser configuration only. Never put server secrets in VITE_* values.
VITE_AUTH_API_BASE=/api/auth

# Configure these with Firebase Functions secret management, never in this file:
# NIC_HMAC_KEY              32+ random bytes, base64 or strong text
# NIC_ENCRYPTION_KEY        exactly 32 random bytes, base64 encoded
# RATE_LIMIT_HMAC_KEY       independent 32+ random bytes
# FIREBASE_WEB_API_KEY      Firebase web API key used server-side for password sign-in
# ALLOWED_ORIGIN            exact HTTPS production origin
