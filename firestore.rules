rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function requestDoc(requestId) {
      return getAfter(/databases/$(database)/documents/relationshipRequests/$(requestId));
    }

    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.publicId is string
        && request.resource.data.loveKeyMasked is string
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'publicId', 'loveKeyMasked', 'privateDetails', 'createdAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.publicId == resource.data.publicId;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /loveKeyIndex/{keyHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /relationshipRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/loveKeyIndex/$(request.resource.data.targetKeyHash)).data.uid == request.resource.data.toUid
        && request.resource.data.fromName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && request.resource.data.toName == get(/databases/$(database)/documents/loveKeyIndex/$(request.resource.data.targetKeyHash)).data.displayName
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toName', 'targetKeyHash', 'status', 'createdAt']);
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }

    match /relationships/{relationshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.status == 'active'
        && request.resource.data.requestId == relationshipId
        && requestDoc(relationshipId).data.status == 'accepted'
        && request.resource.data.participantNames[requestDoc(relationshipId).data.fromUid] == requestDoc(relationshipId).data.fromName
        && request.resource.data.participantNames[requestDoc(relationshipId).data.toUid] == requestDoc(relationshipId).data.toName
        && request.resource.data.participantUids.hasAll([requestDoc(relationshipId).data.fromUid, requestDoc(relationshipId).data.toUid])
        && request.resource.data.participantUids.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && resource.data.status == 'active'
        && request.resource.data.status == 'ended_pending'
        && request.resource.data.breakupRequestedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'breakupRequestedBy', 'breakupAt', 'finalizeAt']);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
